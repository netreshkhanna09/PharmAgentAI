# ==============================================================
# PharmAgentAI — Environment Variables Template
# ==============================================================
# 1. Copy this file: cp .env.example .env
# 2. Fill in your actual API keys in .env
# 3. NEVER commit your .env file to GitHub!
# ==============================================================

# --- LLM Provider (Groq — Free Tier Available) ---
# Get your key at: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# --- Embeddings Provider (OpenAI) ---
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# --- PostgreSQL Database (Long-term Memory) ---
# Local development: postgresql://user:password@localhost:5432/pharmagent
DATABASE_URL=postgresql://postgres:password@localhost:5432/pharmagent_db

# --- LLM Settings ---
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# --- Agent Settings ---
MAX_RETRY_LOOPS=3           # Max retries before Human-in-the-Loop escalation
LOG_LEVEL=INFO

# --- ClinicalTrials.gov API ---
# No key needed — public API
CLINICAL_TRIALS_BASE_URL=https://clinicaltrials.gov/api/v2

# --- Action Agent: Email Notification ---
# When a claim is approved, the system emails the requestor.
# Setup steps:
#   1. Use a Gmail account
#   2. Enable 2-Factor Authentication on that account
#   3. Go to: Google Account → Security → App Passwords
#   4. Create an App Password (select "Mail" + "Windows Computer")
#   5. Copy the 16-character password (e.g. "abcd efgh ijkl mnop")
#   6. Paste it below WITHOUT spaces
EMAIL_ENABLED=false
EMAIL_SENDER=your_gmail@gmail.com
EMAIL_APP_PASSWORD=your_16_char_app_password_here
